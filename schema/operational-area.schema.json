{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/operational-area.schema.json",
  "title": "Operational Area",
  "description": "Minimal GeoJSON Feature for operational-area awareness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "properties",
    "geometry"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id",
        "site_id",
        "metro_locality"
      ],
      "properties": {
        "operator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "metro_locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "center_point": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "geographic_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "south",
            "west",
            "north",
            "east"
          ],
          "properties": {
            "south": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "west": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "north": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "east": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "coordination_contact": {
          "type": "string",
          "maxLength": 300
        },
        "effective_from": {
          "type": "string",
          "maxLength": 100
        },
        "effective_to": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  }
}
